{
  "name": "tamago",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "electron electron/main.js",
    "desktop:build": "electron-builder"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "^16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.chewytapioca.tamago",
    "productName": "Tamago",
    "files": ["electron/**/*"],
    "directories": { "output": "dist-desktop" },
    "mac": { "category": "public.app-category.entertainment" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
